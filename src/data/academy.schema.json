{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crehds.github.io/expresion-latina/academy.schema.json",
  "title": "Expresión Latina academy content",
  "description": "Single source of truth for everything the public site renders. Generated by scripts/data/import.mjs; do not edit academy.json by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "studio",
    "days",
    "timeSlots",
    "genres",
    "teachers",
    "videos",
    "sessions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "generatedFrom": {
      "type": ["string", "null"]
    },
    "_note": {
      "type": "string"
    },
    "studio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": ["string", "null"]
        },
        "country": {
          "type": ["string", "null"]
        },
        "address": {
          "type": ["string", "null"]
        },
        "phone": {
          "type": ["string", "null"]
        },
        "whatsapp": {
          "type": ["string", "null"]
        },
        "email": {
          "type": ["string", "null"]
        },
        "mapEmbedUrl": {
          "type": ["string", "null"]
        },
        "social": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facebook": {
              "type": ["string", "null"]
            },
            "instagram": {
              "type": ["string", "null"]
            },
            "tiktok": {
              "type": ["string", "null"]
            },
            "youtube": {
              "type": ["string", "null"]
            }
          }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "shortName", "weekday"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string",
            "minLength": 1
          },
          "weekday": {
            "description": "Matches Date#getDay(): 0 is Sunday. Array order is display order and is independent of this.",
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "timeSlots": {
      "description": "Only slots the academy actually uses. Derived from the sessions, never a fixed grid.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "end", "label"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "start": {
            "$ref": "#/$defs/time"
          },
          "end": {
            "$ref": "#/$defs/time"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "slug"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "description": "A class is offered to students and listed on the classes page. A rehearsal occupies the schedule but is not a dance style.",
            "enum": ["class", "rehearsal"],
            "default": "class"
          },
          "description": {
            "type": "string"
          },
          "accentColor": {
            "type": ["string", "null"]
          },
          "videoIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        }
      }
    },
    "teachers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "shortName": {
            "type": "string"
          },
          "imageKey": {
            "description": "File name resolved through src/data/assets.js. Null when the academy has no photo of this teacher yet.",
            "type": ["string", "null"],
            "minLength": 1
          },
          "genreIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "bio": {
            "type": "string"
          },
          "social": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "facebook": {
                "type": ["string", "null"]
              },
              "instagram": {
                "type": ["string", "null"]
              },
              "tiktok": {
                "type": ["string", "null"]
              }
            }
          },
          "videoIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "genreId": {
            "oneOf": [
              {
                "$ref": "#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "assetKey": {
            "type": ["string", "null"]
          },
          "externalUrl": {
            "type": ["string", "null"]
          },
          "teacherId": {
            "oneOf": [
              {
                "$ref": "#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "sessions": {
      "description": "One entry per class that actually runs. Absent day/slot combinations are free time; the weekly grid is derived, never stored.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dayId", "slotId", "genreId"],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "dayId": {
            "$ref": "#/$defs/slug"
          },
          "slotId": {
            "$ref": "#/$defs/slug"
          },
          "genreId": {
            "$ref": "#/$defs/slug"
          },
          "teacherId": {
            "oneOf": [
              {
                "$ref": "#/$defs/slug"
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "type": ["string", "null"]
          },
          "room": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": ["string", "null"]
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  }
}
