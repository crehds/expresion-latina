# Copy this file to .env.local (gitignored) and fill in the values.
# Vite inlines every VITE_ variable into the bundle at build time, so all of
# them are public once deployed. Never put a secret here.

# --- Member accounts (Supabase) ---
# Kill switch: the member feature is on only when BOTH values are non-blank.
# Leave either one empty and the site builds as the public schedule only.
# The URL also feeds the Content-Security-Policy connect-src at build time.
#
# Local stack: run `npx supabase@2.117.0 status` and copy the API URL
# (http://127.0.0.1:54321) and the publishable key.
# Hosted project: Supabase dashboard > Project Settings > API Keys.
# Use the publishable key (sb_publishable_...), never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Home carousel posters (optional) ---
# Leave empty to show only the bundled posters; no request is made.
VITE_POSTERS_API_URL=
# Days without a keep-alive ping before the admin banner shows: a whole number of 1 or more (default 3), or "off" to hide it. Anything else fails `vite build`.
VITE_KEEPALIVE_ALERT_DAYS=3

# --- Local Google sign-in (optional, local stack only) ---
# Read by supabase/config.toml through env(), not by Vite: without the VITE_
# prefix they stay out of the bundle. Leave them empty unless Google is on in
# config.toml; see "Local auth" in supabase/README.md. The hosted project keeps
# its Google settings in the Supabase dashboard, not here.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
